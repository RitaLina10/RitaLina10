# ---- Proxy HTTPS (Caddy) ----
# Domínio apontando para o IP público do servidor. Sem domínio próprio? Use um gratuito:
# DuckDNS (suaempresa.duckdns.org) ou similar.
DOMAIN=gases.suaempresa.com.br
ACME_EMAIL=ti@suaempresa.com.br
# Rede local sem domínio: CADDYFILE=Caddyfile.lan e LAN_HOST=192.168.0.10
CADDYFILE=Caddyfile
LAN_HOST=

# ---- Aplicação ----
# development | test | production
APP_ENV=production
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_MINUTES=480
# SQLite (padrão) ou PostgreSQL (instale psycopg[binary]): postgresql+psycopg://user:pass@host:5432/gascontrol
DATABASE_URL=sqlite:////data/gascontrol.db
# Admin criado apenas no primeiro boot (banco vazio). Remova após o primeiro login.
ADMIN_EMAIL=admin@suaempresa.com.br
ADMIN_PASSWORD=
# Validade do teste hidrostático (anos) e antecedência do alerta (dias)
HYDRO_TEST_VALIDITY_YEARS=5
HYDRO_ALERT_DAYS=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
# Se definido, /metrics exige "Authorization: Bearer <token>"
METRICS_TOKEN=
LOG_LEVEL=INFO

# ---- Backup ----
BACKUP_INTERVAL_HOURS=6
BACKUP_KEEP=56

# ---- NF-e (opcional) ----
# none = emissão desligada (rascunhos funcionam); focusnfe = emissão via Focus NFe (serviço pago)
FISCAL_PROVIDER=none
FOCUS_TOKEN=
# homologacao (testes, sem valor fiscal) | producao
FOCUS_ENVIRONMENT=homologacao
EMITTER_CNPJ=
EMITTER_UF=SP
FISCAL_CANCEL_HOURS=24
# intervalo (s) da consulta automática de notas em processamento; 0 desliga
FISCAL_POLL_SECONDS=60
